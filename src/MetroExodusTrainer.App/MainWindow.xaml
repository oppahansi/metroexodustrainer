<Window x:Class="MetroExodusTrainer.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Metro Exodus Trainer" Width="520" Height="720" MinWidth="440" MinHeight="420"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource Accent}" Margin="0,1,10,0"/>
                <TextBlock Text="METRO EXODUS TRAINER" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource FlatButton}" Width="46" Height="46" Content="&#xE921;"
                        FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Minimize_Click"/>
                <Button Style="{StaticResource FlatButton}" Width="46" Height="46" Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <!-- Status card -->
        <Border Grid.Row="1" Margin="20,4,20,12" Padding="16,14" CornerRadius="12"
                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusTitle}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding StatusDetail}" FontSize="12" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Tag="8" Padding="12,7" Margin="12,0,0,0"
                        Background="{StaticResource SurfaceHover}" Click="Reset_Click"
                        ToolTip="Switch everything off and restore the default values of the game">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Reset all" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ResetHotkey}" FontSize="11" Foreground="{StaticResource TextDim}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Features by category -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,0,14,0">
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,6,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6,0,10">
                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextDim}" Margin="4,6,0,8"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" Margin="0,0,0,6" Padding="16,12" CornerRadius="10" Cursor="Hand"
                                                Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                                BorderThickness="1" MouseLeftButtonUp="Row_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="warn" Text="{Binding Warning}" FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{StaticResource Warn}" TextWrapping="Wrap" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Margin="12,0,16,0" Padding="8,3" CornerRadius="6"
                                                        Background="{StaticResource Bg}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Hotkey}" FontSize="11" FontFamily="Consolas"
                                                               Foreground="{StaticResource TextDim}"/>
                                                </Border>
                                                <ToggleButton Grid.Column="2" Style="{StaticResource Switch}"
                                                              IsChecked="{Binding IsOn, Mode=OneWay}"
                                                              IsEnabled="{Binding CanToggle}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasWarning}" Value="True">
                                                <Setter TargetName="warn" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanToggle}" Value="False">
                                                <Setter TargetName="row" Property="Opacity" Value="0.55"/>
                                                <Setter TargetName="row" Property="Cursor" Value="Arrow"/>
                                            </DataTrigger>
                                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="20,8,20,14">
            <TextBlock x:Name="NumLockNote" Text="NumLock is off. The numpad hotkeys only work while it is on."
                       Foreground="{StaticResource Warn}" FontSize="11" Margin="0,0,0,4" Visibility="Collapsed"/>
            <TextBlock Text="Single-player, offline use only. Closing the trainer restores the default values of the game."
                       Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
